# ─── Game assets (never committed) ────────────────────────────────────────
# Symlinks to and copies of the original game, the Steamless-unpacked exe,
# extracted asset bytes, golden screenshots derived from running the original.
vendor/
docs/decompiled/
docs/findings/**/golden/
tests/golden/**/*.png
tests/golden/**/*.jpg
tests/golden/**/*.bin
tests/golden/**/*.wav
# Phase A scenario goldens — rendered by openrecet.exe but contain
# vendor textures (title bg, RECETTEAR logo, …). The trace + yaml are
# safe to ship; the golden/ subtree is regenerated locally via
# `tools/scenario-test.py <name> --bless`. See
# tests/scenarios/README.md.
tests/scenarios/**/golden/
# Phase B retail goldens — rendered by recettear.unpacked.exe via the
# Frida agent. Same redistribution concern: vendor texture bytes.
tests/scenarios/**/golden-retail/

# ─── TAS save-interception blobs (user save data; never auto-commit) ──────
# Content-addressed save blobs a trace embeds (tools/trace_save.py) + the raw
# snapshot the recorder dumps. These hold the user's personal save state, so
# they stay out of git by default; a specific blob is committed deliberately
# only if a trace genuinely needs it to replay (and the user OKs sharing it).
tests/scenarios/_saves/
*.sav.gz
*.save.bin
openrecet-trace-*.raw.jsonl

# ─── Ghidra projects (large, contain analysis state derived from original) ─
ghidra/projects/
ghidra/*.rep/
ghidra/*.gpr
ghidra/*.lock
*.gpr.lock
*.gpr.lock~

# ─── Build outputs ────────────────────────────────────────────────────────
build/
result
result-*
*.o
*.d
*.obj
*.exe
*.dll
*.pdb
*.ilk
*.map

# ─── Python caches ────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Wine/.NET runtime state ──────────────────────────────────────────────
*.wineprefix/
.cache/

# ─── Test runs (output of tools/smoke-test.py) ────────────────────────────
runs/

# ─── Per-user Claude Code permission grants ───────────────────────────────
.claude/settings.local.json

# ─── Editor/OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
src/se.rc
