#!/usr/bin/env bash
# pre-commit hook — keeps the derived port ledger current and runs the
# Linux-only regression nets BEFORE a commit lands, converting the project's
# "agent remembers to run make" convention into an enforced gate.
#
#   1. Regenerate the derived port ledger (STATUS.md, port-ledger.{json,md})
#      and stage it so it always tracks HEAD with zero manual steps.
#   2. If any C source/header or test changed, build + run the 2870-test
#      ASan/UBSan suite (~10s) and abort the commit on failure.
#
# Bypass for an emergency / WIP commit:  git commit --no-verify
# Installed via core.hooksPath=tools/git-hooks.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# nix wrapper — python3/make live in the dev shell on this host.
run() { nix develop --command "$@"; }

# --- 1. Regenerate + stage the derived ledger ----------------------------
if run python3 tools/gen_port_ledger.py >/tmp/oc_ledger.log 2>&1; then
    git add docs/STATUS.md docs/port-ledger.json docs/port-ledger.md 2>/dev/null || true
else
    echo "pre-commit: port-ledger generation failed:" >&2
    cat /tmp/oc_ledger.log >&2
    exit 1
fi

# --- 2. Run the host test suite if code changed --------------------------
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -qE '^(src/|tests/).*\.(c|h)$'; then
    echo "pre-commit: C sources changed → building + running host suite..."
    if ! run make -C tests run >/tmp/oc_tests.log 2>&1; then
        echo "pre-commit: host test suite FAILED — commit aborted:" >&2
        tail -30 /tmp/oc_tests.log >&2
        echo "(bypass with: git commit --no-verify)" >&2
        exit 1
    fi
    echo "pre-commit: $(grep -oE '[0-9]+ passed' /tmp/oc_tests.log | tail -1)"
fi

# --- 3. Remind to regen visual comparisons after render/logic edits ------
if echo "$staged" | grep -qE '^src/(scene1_|render|d3d|font_|sprite|layers|tables).*\.(c|h)$'; then
    echo "pre-commit: render/logic files changed — remember to run" >&2
    echo "            tools/regen-comparisons.py and eyeball runs/comparisons/index.html" >&2
fi

exit 0
